# Variables de Entorno - Tienda Escolar Virtual (I.E.D. Los Laureles)
# Copiar este archivo a .env y ajustar las credenciales según el entorno.
# En Render estas variables se configuran en el panel del servicio (NO subir .env).

# Configuración del Servidor Flask
FLASK_APP=main.py
FLASK_ENV=development
FLASK_DEBUG=1
SECRET_KEY=cambie_esta_clave_por_una_larga_y_aleatoria
PORT=5000

# Configuración de Base de Datos MySQL
# Opción A: variables individuales
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=tienda_escolar

# Opción B: una sola URL (tiene prioridad sobre las variables DB_*)
# DATABASE_URL=mysql://usuario:clave@host:3306/tienda_escolar

# Desactivar SSL solo si el proveedor de MySQL no lo soporta
# DB_SSL=true

# Inicializar tablas y datos semilla automáticamente al arrancar (true/false)
AUTO_INIT_DB=true

# Forzar cookies seguras (se activa solo en producción por defecto)
# SESSION_COOKIE_SECURE=true

# URL pública opcional para el código QR (sustentación)
NGROK_URL=
